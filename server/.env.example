PORT=8080
NODE_ENV=development

# PostgreSQL connection string used by Prisma. Replace with your own
# credentials locally - never commit a real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devpilot"

# Origin of the Next.js frontend, used for CORS + cookie handling.
CORS_ORIGIN=http://localhost:3000

# AI provider selection. "anthropic" is the only implemented provider today;
# this exists so a future provider can be added without changing call sites.
AI_PROVIDER=anthropic

# Server-side only - never exposed to the client. Required for AI chat to
# work; the rest of the app functions normally without it.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required, no hardcoded fallback in code on purpose - set this explicitly
# so it never silently goes stale. See https://docs.anthropic.com/en/docs/about-claude/models
# for current model ids.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
