PORT=8080
NODE_ENV=development

# PostgreSQL connection string used by Prisma. Replace with your own
# credentials locally - never commit a real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devpilot"

# Origin of the Next.js frontend, used for CORS + cookie handling.
CORS_ORIGIN=http://localhost:3000

# AI provider selection - "anthropic" or "gemini". Only the selected
# provider's own variables below are required at runtime (see
# config/ai.ts); the other provider's variables can be left unset.
AI_PROVIDER=anthropic

# --- Required only when AI_PROVIDER=anthropic -----------------------------
# Server-side only - never exposed to the client.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required, no hardcoded fallback in code on purpose - set this explicitly
# so it never silently goes stale. See https://docs.anthropic.com/en/docs/about-claude/models
# for current model ids.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Required only when AI_PROVIDER=gemini --------------------------------
# Server-side only - never exposed to the client.
GEMINI_API_KEY=your-gemini-api-key

# Required, no hardcoded fallback in code on purpose. See
# https://ai.google.dev/gemini-api/docs/models for current model ids.
GEMINI_MODEL=gemini-3.6-flash

# Document embeddings/RAG search run on a local model (no API key, no paid
# usage) - nothing to configure here.
