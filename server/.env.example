PORT=8080
NODE_ENV=development

# PostgreSQL connection string used by Prisma Client at runtime (every
# normal query the app makes). Replace with your own credentials locally -
# never commit a real value. If your provider (e.g. Neon) offers a pooled
# connection string, use it here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devpilot"

# Direct (unpooled) PostgreSQL connection string, used only by Prisma
# Migrate/CLI (`prisma migrate`, `prisma db push`, etc.), never by the
# running app. Required when DATABASE_URL points at a pooled connection
# (e.g. Neon's pooler/PgBouncer) - pooled connections in transaction mode
# don't support the session-level locks migrations need, so Prisma uses
# this separate, direct connection for schema changes instead. Replace
# with your own credentials locally - never commit a real value.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/devpilot"

# Origin of the Next.js frontend, used for CORS + cookie handling.
CORS_ORIGIN=http://localhost:3000

# AI provider selection - "anthropic" or "gemini". Only the selected
# provider's own variables below are required at runtime (see
# config/ai.ts); the other provider's variables can be left unset.
AI_PROVIDER=anthropic

# --- Required only when AI_PROVIDER=anthropic -----------------------------
# Server-side only - never exposed to the client.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required, no hardcoded fallback in code on purpose - set this explicitly
# so it never silently goes stale. See https://docs.anthropic.com/en/docs/about-claude/models
# for current model ids.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Required only when AI_PROVIDER=gemini --------------------------------
# Server-side only - never exposed to the client.
GEMINI_API_KEY=your-gemini-api-key

# Required, no hardcoded fallback in code on purpose. See
# https://ai.google.dev/gemini-api/docs/models for current model ids.
GEMINI_MODEL=gemini-3.6-flash

# Document embeddings/RAG search run on a local model (no API key, no paid
# usage). Optional: where the model's downloaded weights are cached on
# disk. Defaults to ./.cache/transformers-model (relative to the server's
# working directory) if unset - fine for local dev, but in production this
# should point at a persistent volume/disk so a fresh deploy doesn't
# re-download the model every time. Not the Python-only HF_HOME/
# TRANSFORMERS_CACHE convention - this JS library only reads this variable.
# EMBEDDING_MODEL_CACHE_DIR=/data/transformers-model-cache

# Optional: run one embedding-model load at server startup instead of
# waiting for the first real request to trigger it. "true" to enable;
# unset/anything else leaves the model loading lazily on first use (the
# default, and the best choice for local dev so `npm run dev` doesn't pay
# this cost on every restart).
# EMBEDDING_MODEL_WARMUP=true
