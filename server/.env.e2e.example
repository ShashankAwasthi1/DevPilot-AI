# E2E test environment for the backend - copy to server/.env.e2e and fill
# in real local values. Loaded only by client/playwright.config.ts's
# webServer for the backend process; `npm run dev`/`npm start` never read
# this file, so it cannot affect normal local development.
#
# NEVER point DATABASE_URL/DATABASE_URL_UNPOOLED at the production Neon
# database, or at any shared/staging database. Use a dedicated, disposable
# LOCAL PostgreSQL database created only for E2E runs - see
# client/e2e/README.md for the exact setup and migration commands.

NODE_ENV=development
PORT=8080

# A dedicated local Postgres database - NOT production Neon. Both
# variables point at the SAME local database: a plain local Postgres
# instance has no pooled/direct distinction the way Neon does, so
# server/.env.example's split between a pooled DATABASE_URL and a direct
# DATABASE_URL_UNPOOLED doesn't apply here.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devpilot_e2e"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/devpilot_e2e"

# Must match the frontend's local E2E origin (client/.env.e2e.example /
# playwright.config.ts's baseURL).
CORS_ORIGIN=http://localhost:3000

# AI chat/pending-action flows are intentionally NOT covered by the
# initial E2E suite (see PHASE 26 Step 1's investigation: no mock AI
# provider exists yet, so real E2E coverage would require a real,
# budget-limited provider key and would be flaky/slow). AI config is only
# validated lazily on the first real chat request (see
# src/config/ai.ts), so the server starts up fine for the auth/project/
# task E2E flows without a real key - these two values can be left as
# harmless placeholders.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=e2e-placeholder-unused
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
