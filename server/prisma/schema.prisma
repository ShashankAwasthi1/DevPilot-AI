// Prisma schema for DevPilot AI
// Core entities only (Phase 3). Auth, documents, AI, and analytics tables
// are added in later phases per BLUEPRINT.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [vector]
}

enum ProjectMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  COMMENT_CREATED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_ARCHIVED
}

enum NotificationType {
  TASK_COMMENT_CREATED
  TASK_ASSIGNED
}

enum MessageRole {
  USER
  ASSISTANT
}

// Phase 19: lifecycle of an AI-proposed task creation. A row only ever
// moves PENDING -> CONFIRMED or PENDING -> CANCELLED, both via a single
// atomic conditional update (WHERE status = PENDING) at confirm/cancel
// time - that update's affected-row-count is the entire idempotency/
// replay-prevention mechanism, so no other status transition is valid.
// EXPIRED is not currently written by anything (expiry is checked lazily
// against expiresAt at confirm time, see the Phase 19 Step 3 design) -
// kept as a distinct value now so a future cleanup job can mark stale
// PENDING rows without a schema change, rather than inventing a meaning
// for it later.
enum PendingTaskActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

// Phase 24: distinguishes a proposal that would create a brand-new Task
// (no existing task to point at - PendingTaskAction.taskId is null) from
// one that would update an existing Task (taskId is set). Defaults to
// CREATE_TASK so every pre-Phase-24 row is unambiguously and correctly
// backfilled by this default alone, with no separate data migration.
enum PendingTaskActionType {
  CREATE_TASK
  UPDATE_TASK
  // Phase 25: a proposal that would create MULTIPLE new tasks at once (an
  // AI-generated project plan) - like CREATE_TASK, taskId stays null (no
  // existing task to point at); unlike either existing type, confirming
  // this one populates resultTaskIds (plural) instead of resultTaskId.
  CREATE_PROJECT_PLAN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects      Project[]           @relation("ProjectOwner")
  memberships        ProjectMember[]
  createdTasks       Task[]              @relation("TaskCreatedBy")
  assignedTasks      Task[]              @relation("TaskAssignee")
  comments           Comment[]
  sessions           Session[]
  activities         Activity[]
  notifications      Notification[]
  documents          Document[]
  conversations      Conversation[]
  pendingTaskActions PendingTaskAction[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerId     String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner              User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  members            ProjectMember[]
  tasks              Task[]
  activities         Activity[]
  documents          Document[]
  conversations      Conversation[]
  pendingTaskActions PendingTaskAction[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee           User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("TaskCreatedBy", fields: [createdById], references: [id])
  comments           Comment[]
  activities         Activity[]
  // Phase 24: only ever non-empty for an UPDATE_TASK proposal (see
  // PendingTaskAction.taskId) - a CREATE_TASK proposal has no existing
  // task to point at yet.
  pendingTaskActions PendingTaskAction[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
  @@map("comments")
}

model Activity {
  id        String       @id @default(cuid())
  projectId String
  taskId    String?
  actorId   String?
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([actorId])
  @@map("activities")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Document {
  id         String    @id @default(cuid())
  projectId  String
  authorId   String
  title      String
  content    String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id])
  chunks  DocumentChunk[]

  @@index([projectId])
  @@index([projectId, archivedAt, createdAt])
  @@index([authorId])
  @@map("documents")
}

// Conversations are per-user within a project (not shared/team chat) - kept
// deliberately simple for Phase 12. Read-only AI chat; no toolCalls/usage
// columns yet, those belong to the tool-calling and usage-tracking phases.
model Conversation {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           Message[]
  pendingTaskActions PendingTaskAction[]

  @@index([projectId, userId, createdAt, id])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("messages")
}

// Phase 19: an AI-proposed createTask action awaiting explicit user
// confirmation. The AI tool that creates this row NEVER writes to `tasks`
// itself (see server/src/ai/tools/create-task.tool.ts) - only a
// separately-authenticated confirm endpoint (a later Phase 19 step) may
// call task.service.ts's own createTask() using `proposedInput` verbatim.
// `proposedInput` stores exactly the Zod-validated tool input (never
// re-editable at confirm time - see the Phase 19 Step 3 design's
// "Prevents modifying the proposed payload" requirement). `projectId`/
// `userId` are always the values from the AI tool's server-side
// ToolContext, never anything the model or a client could supply.
model PendingTaskAction {
  id             String                  @id @default(cuid())
  conversationId String
  projectId      String
  userId         String
  actionType     PendingTaskActionType   @default(CREATE_TASK)
  // Only set for an UPDATE_TASK proposal - null for CREATE_TASK, since
  // there's no existing task yet. onDelete: Cascade mirrors every other
  // FK on this model: if the target task is deleted before an update
  // proposal is confirmed, the proposal is deleted with it rather than
  // left dangling.
  taskId         String?
  proposedInput  Json
  status         PendingTaskActionStatus @default(PENDING)
  resultTaskId   String?
  // Phase 25: only ever populated for a confirmed CREATE_PROJECT_PLAN
  // action (the ids of every task the plan created) - empty for
  // CREATE_TASK/UPDATE_TASK rows, which use the singular resultTaskId
  // above instead. Defaults to an empty array so every pre-existing row
  // backfills cleanly with no separate data migration.
  resultTaskIds  String[]                @default([])
  resultError    String?
  createdAt      DateTime                @default(now())
  expiresAt      DateTime
  confirmedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@index([conversationId])
  @@index([status, expiresAt])
  @@index([taskId])
  @@map("pending_task_actions")
}

// Phase 14: chunks of a Document's content, each with an embedding vector
// for semantic search (see docs/adr and the Phase 14 plan). Chunks are
// treated as immutable - re-indexing deletes and recreates them, so there
// is no updatedAt here. projectId is denormalized from the parent Document
// so retrieval can filter/authorize directly on this table without a join,
// and so the vector index's filtered scans stay fast.
//
// The `embedding` column itself (vector(384), NOT NULL, plus its HNSW
// index) is added via hand-written SQL in this model's migration, not
// through this schema - Prisma's `Unsupported` type is excluded from the
// generated Client entirely, and there is no Prisma DSL for pgvector's
// HNSW/cosine operator class. All reads/writes to `embedding` go through
// $queryRaw/$executeRaw in the service layer (Phase 14, later steps).
// Dimension is 384 to match the local embedding model
// (Xenova/all-MiniLM-L6-v2, see ../src/ai/local-embedding-provider.ts) -
// originally 1536 for OpenAI's text-embedding-3-small, changed by the
// pgvector-384 migration when embeddings moved local-only.
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  projectId  String
  chunkIndex Int
  content    String
  charCount  Int
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(384)")

  @@index([documentId, chunkIndex])
  @@index([projectId])
  @@map("document_chunks")
}
