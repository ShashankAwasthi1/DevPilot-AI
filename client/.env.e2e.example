# E2E test environment for the frontend - copy to client/.env.e2e and fill
# in real local values if you need something other than the defaults
# below. Loaded only by playwright.config.ts's webServer for the frontend
# process; `npm run dev` never reads this file, so it cannot affect normal
# local development. These are the same NEXT_PUBLIC_* values client/dev
# already uses by default - listed here explicitly so the full set of
# variables this suite depends on is documented in one place per app.

# The local backend started by playwright.config.ts's webServer, using the
# dedicated E2E database configured in server/.env.e2e (see
# server/.env.e2e.example and client/e2e/README.md).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
